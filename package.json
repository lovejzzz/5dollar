{
  "name": "five-agent-preview",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && tsx --test tests/live-contract.test.ts tests/migrations.test.ts tests/sponsor-api.test.ts tests/relay.test.ts tests/tremendous-contract.test.ts && NODE_OPTIONS='--import=./tests/helpers/cloudflare-register.mjs' tsx --test tests/live-state.test.ts tests/live-canary.test.ts tests/resend-webhook-route.test.ts tests/sponsor-state.test.ts tests/sponsor-process.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "verify:live-canary": "node scripts/verify-live-canary.mjs",
    "relay:deploy": "wrangler deploy --config relay/wrangler.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "svix": "1.96.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "js-yaml": "4.3.0",
    "postcss": "8.5.14"
  },
  "type": "module"
}
