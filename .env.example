# Keep both modes on sandbox until every live prerequisite is configured.
FIVE_MODE=sandbox
REWARD_PROVIDER=tremendous
TREMENDOUS_MODE=sandbox
PAYPAL_MODE=sandbox

# Generate independent 32-byte unpadded base64url keys for these two values.
PAYOUT_ENCRYPTION_KEY=
PAYOUT_FINGERPRINT_KEY=

# A long random bearer secret used only by the task and processor endpoints.
PROCESSOR_SECRET=
TASK_ADMIN_SECRET=

# AI task runner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_BASE_URL=

# Gift-card provider. Test Flight keys start with TEST_; production keys start
# with PROD_. Never put either value in the repository.
TREMENDOUS_API_KEY=
TREMENDOUS_CAMPAIGN_ID=
TREMENDOUS_FUNDING_SOURCE_ID=

# Optional future PayPal payout adapter. It is inactive when
# REWARD_PROVIDER=tremendous.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Transactional gift-card delivery. The sender must use a verified domain.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NOTIFICATION_FROM_EMAIL=Five <payouts@example.com>
SUPPORT_EMAIL=support@example.com

# Private-beta gate for creating new sponsor Checkout orders. Leave empty to
# disable self-serve sponsor funding while keeping operator-funded tasks active.
SPONSOR_ALLOWED_EMAILS=
SPONSOR_SITE_ORIGIN=https://your-canonical-site.example

# Optional test seam. Leave empty to use official provider endpoints.
TREMENDOUS_API_BASE_URL=
PAYPAL_API_BASE_URL=
RESEND_API_BASE_URL=
PROVIDER_TEST_MODE=
