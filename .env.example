# Keep both modes on sandbox until every live prerequisite is configured.
FIVE_MODE=sandbox
PAYPAL_MODE=sandbox

# Generate independent 32-byte unpadded base64url keys for these two values.
PAYOUT_ENCRYPTION_KEY=
PAYOUT_FINGERPRINT_KEY=

# A long random bearer secret used only by the task and processor endpoints.
PROCESSOR_SECRET=
TASK_ADMIN_SECRET=

# AI task runner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_BASE_URL=

# PayPal Payouts business app. Live mode requires approved Payouts access,
# verified webhook configuration, and a funded PayPal balance.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Transactional arrival notice. The sender must use a verified domain.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NOTIFICATION_FROM_EMAIL=Five <payouts@example.com>
SUPPORT_EMAIL=support@example.com

# Private-beta gate for creating new sponsor Checkout orders. Leave empty to
# disable self-serve sponsor funding while keeping operator-funded tasks active.
SPONSOR_ALLOWED_EMAILS=
SPONSOR_SITE_ORIGIN=https://your-canonical-site.example

# Optional test seam. Leave empty to use the official endpoint for PAYPAL_MODE.
PAYPAL_API_BASE_URL=
RESEND_API_BASE_URL=
PROVIDER_TEST_MODE=
